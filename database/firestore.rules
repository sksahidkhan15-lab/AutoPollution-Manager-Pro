rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: check if Super Admin
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.email == 'admin@autopollution.com'
      );
    }

    // Helper function: verify user belongs to this specific centre
    function isCentreOwner(centreId) {
      return isAuthenticated() && (
        request.auth.uid == centreId || 
        request.auth.token.centreId == centreId
      );
    }

    // Centres Collection
    match /centres/{centreId} {
      // Super Admin has full control
      allow read, write: if isSuperAdmin();
      
      // Approved centres can read their own profile
      allow read: if isCentreOwner(centreId);
      
      // New centres can register in pending status
      allow create: if isAuthenticated() && request.resource.data.status == 'pending';
      
      // Centres can update non-critical profile fields
      allow update: if isCentreOwner(centreId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role', 'centreId', 'plan', 'subscriptionValidTill']);

      // Subcollection: Vehicles (Strict Tenant Isolation)
      match /vehicles/{vehicleId} {
        allow read, write: if isCentreOwner(centreId) || isSuperAdmin();
        
        // Ensure required fields and valid vehicle number on write
        allow create, update: if (isCentreOwner(centreId) || isSuperAdmin()) &&
          request.resource.data.vno is string &&
          request.resource.data.vno.size() >= 4 &&
          request.resource.data.owner is string &&
          request.resource.data.phone is string;
      }

      // Subcollection: Reminders Log
      match /reminders/{reminderId} {
        allow read, write: if isCentreOwner(centreId) || isSuperAdmin();
      }

      // Subcollection: Centre Settings & Message Templates
      match /settings/{docId} {
        allow read, write: if isCentreOwner(centreId) || isSuperAdmin();
      }
    }

    // Platform Plans & Configuration (Public read, Super Admin write)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
