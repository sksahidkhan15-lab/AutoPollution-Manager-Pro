# AutoPollution Manager Pro - Backend Environment Variables
# Copy this file to .env and insert your real production secrets.
# NEVER commit the .env file to GitHub!

# 1. Server Configuration
PORT=8080
NODE_ENV=production

# 2. Firebase Admin Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 3. Meta WhatsApp Cloud API (Official Graph API v19.0)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_SYSTEM_USER_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=autopollution_webhook_secret_token_2026

# 4. Razorpay India Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 5. Indian TRAI / DLT SMS Gateway (Fast2SMS / TextLocal / Msg91)
SMS_GATEWAY_API_KEY=your_dlt_sms_api_key_here
SMS_SENDER_ID=PUCIND
SMS_ENTITY_ID=1101XXXXXXXXXX
SMS_GATEWAY_URL=https://api.sms-provider.in/v1/send
